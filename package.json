{
  "name": "auto-fill-extension",
  "displayName": "Auto fill extension",
  "version": "0.0.1",
  "description": "auto fill web extension tool which helps users to fill any forms with low effort.",
  "author": "muny, seng and lisa",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "lucide-react": "^0.545.0",
    "motion": "^12.23.22",
    "plasmo": "^0.90.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "4.1.14"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@types/chrome": "0.1.22",
    "@types/node": "24.7.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "storage",
      "activeTab",
      "scripting"
    ]
  }
}
