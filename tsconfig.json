{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules",
    "react:jsx"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "./**/*.ts",
    "./**/*.tsx",
    "./**/*.d.ts"
  ],
  "compilerOptions": {
    "paths": {
      "~*": [
        "./src/*"
      ]
    },
    "baseUrl": ".",
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0" // Suppress deprecation warnings for TypeScript 5.x compatibility

  }
}
